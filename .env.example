PORT=3000
DATABASE_URL="mysql://user:password@localhost:3307/gobull"
JWT_SECRET="super-secret-jwt-key"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:4000"

MYSQL_ROOT_PASSWORD="root"
MYSQL_PASSWORD="password"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# ── Alpha Vantage (catálogo de instrumentos) ──────────
# API key gratuita: https://www.alphavantage.co/support/#api-key
# ALPHAVANTAGE_API_KEY=""

# ── SSR "allowed hosts" ───────────────────────────────
# Lista de dominios aceptados por el SSR (protección SSRF de Angular).
# En local NO hace falta tocar nada: ya acepta localhost/127.0.0.1.
# SOLO cuando publiques con un dominio real agrégalo aquí (separado por comas)
# y regenera el contenedor frontend.
# NG_ALLOWED_HOSTS="localhost,127.0.0.1,app.midominio.com"

# ── Noticias financieras (Marketaux) ──────────────────
# API key gratuita: https://www.marketaux.com/register
MARKETAUX_API_KEY=""
NEWS_LANGUAGES="es"
# Tope diario real del plan gratuito de Marketaux: 100 peticiones.
# Freshness por defecto cada hora para dejar presupuesto al backfill.
NEWS_SYNC_FRESHNESS_CRON="0 * * * *"
NEWS_SYNC_DEPTH_CRON="0 */6 * * *"
NEWS_RETENTION_DAYS=90
# Backfill historico de posiciones abiertas (fuentes de alto impacto).
NEWS_BACKFILL_ENABLED=true
NEWS_BACKFILL_DAYS=90
NEWS_SYNC_BACKFILL_CRON="20 */6 * * *"
  # Dominios hispanos preferidos para la ingesta dirigida (separados por comas).
  # NEWS_PREFERRED_DOMAINS="businessinsider.es,merca2.es,economista.mx,elconfidencial.com,expansion.com,lavanguardia.com,elpais.com"

# ── Web Push & Notificaciones ─────────────────────────
NEWS_PUSH_MIN_SCORE=70
NEWS_PUSH_MAX_PER_DAY=5
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contacto@gobull.local"